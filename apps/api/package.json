{
  "name": "@coursematch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:integration": "node -e \"process.env.DATABASE_URL||(console.error('DATABASE_URL is required; see docs/testing/api-integration-tests.md'),process.exit(1))\" && vitest run src/routes/activities/config.integration.test.ts src/routes/activities/provision-accounts.integration.test.ts"
  },
  "dependencies": {
    "@coursematch/allocation": "*",
    "@coursematch/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
