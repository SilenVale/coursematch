DATABASE_URL=postgres://coursematch:coursematch@localhost:5432/coursematch
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_HOURS=8
# Dev 联调：分配结果页「联调工具」（模拟填报 / 清空 / 一键分配）。生产勿开。
# ENABLE_DEV_TOOLS=1
# 名单「开通账号」时的学生初始密码（未设置时默认 12345678）
# STUDENT_DEFAULT_PASSWORD=12345678
# seed：accounts=仅账号 | ready=+teacher_ready 选课数据 | full=+teacher01 旧示例
SEED_MODE=accounts
# RUN_SEED=1  # 容器启动时执行 seed（生产环境保持 0）

# 选课助理（可选）：在服务端配置后，所有登录教师共用，无需各自填浏览器密钥
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-flash
